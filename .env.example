# Local MySQL managed by scripts/mysql.sh (port 3308)
SMARTPLANNER_DB_URL=jdbc:mysql://127.0.0.1:3308/smartplanner?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
SMARTPLANNER_DB_USERNAME=smartplanner
SMARTPLANNER_DB_PASSWORD=smartplanner

# Python scheduling engine
SMARTPLANNER_ENGINE_URL=http://127.0.0.1:8000

# Java API CORS
SMARTPLANNER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Frontend calls the API directly (CORS); no Next.js proxy needed.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
